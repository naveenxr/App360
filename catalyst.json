{
  "$schema": "https://raw.githubusercontent.com/zoho/catalyst-cli/master/schemas/catalyst.schema.json",
  "name": "app360",
  "client": {
    "source": "frontend/out"
  },
  "appsail": [
    {
      "name": "app360-backend",
      "source": "backend",
      "stack": "node20",
      "build": "npm install",
      "run": "node src/server.js",
      "env_variables": {
        "NODE_ENV": "production",
        "FRONTEND_URL": "https://app360.onslate.in",
        "CLIENT_URL": "https://app360.onslate.in",
        "CORS_ORIGINS": "http://localhost:3000,https://app360.onslate.in",
        "BCRYPT_SALT_ROUNDS": "12",
        "JWT_EXPIRES_IN": "1d",
        "INGESTION_ENABLED": "true"
      }
    },
    {
      "source": "appsail-nodejs",
      "name": "Backend"
    }
  ]
}
